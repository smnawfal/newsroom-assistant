# Copy this file to .env. Keep your .env private.
# Optional: leave blank to use the built-in offline answer mode.
ANTHROPIC_API_KEY=

# Main app settings. Paths are relative to the project folder unless absolute.
NEWSROOM_APP_NAME=PulseWire
NEWSROOM_API_HOST=127.0.0.1
NEWSROOM_API_PORT=8000
# Optional: set if the browser should use a different API address.
NEWSROOM_API_URL=
NEWSROOM_DATABASE_PATH=backend/newsroom.db

# Editable JSON files for feeds, categories, search synonyms, and evaluations.
NEWSROOM_FEEDS_FILE=backend/feeds.json
NEWSROOM_CATEGORIES_FILE=backend/categories.json
NEWSROOM_SEARCH_FILE=backend/search_config.json
NEWSROOM_EVALUATION_FILE=backend/evaluation_cases.json

# Refresh and processing settings.
NEWSROOM_AUTO_REFRESH=true
NEWSROOM_FEED_REFRESH_SECONDS=180
NEWSROOM_STATUS_REFRESH_SECONDS=25
NEWSROOM_FEED_TIMEOUT_SECONDS=14
NEWSROOM_CLUSTER_MAX_ARTICLES=250
NEWSROOM_CLUSTER_SIMILARITY_THRESHOLD=0.24
NEWSROOM_CLUSTER_MIN_SHARED_TERMS=2
NEWSROOM_EXCERPT_WORD_LIMIT=120
NEWSROOM_USER_AGENT=NewsroomAssistant/1.0 (RSS reader)

# Add another frontend origin here if the app is hosted somewhere else.
NEWSROOM_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Optional: set a different Anthropic model name supported by your account.
ANTHROPIC_MODEL=claude-sonnet-4-6
